{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/baseline0/periodic-table-inspector/blob/main/data/schemas/facet.schema.json",
  "title": "Facet record",
  "description": "One facet of one element. The same record shape is used inline in data/elements.json and in modular files under data/facets/. Facet-specific fields (countries, tickers, text) are free-form; metrics and summary are the generic fields used by modular facets.",
  "type": "object",
  "required": ["status"],
  "not": { "required": ["verified"] },
  "properties": {
    "status": {
      "type": "string",
      "enum": ["unaudited", "agent-extracted", "human-verified", "disputed"],
      "description": "unaudited: hand-written, or not sourced. agent-extracted: a script or agent read the cited source; a person has not checked it. human-verified: a person checked each value against its citation. disputed: a correction is open."
    },
    "summary": { "type": "string" },
    "dispute_url": { "type": "string", "pattern": "^https://" },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["label", "value"],
        "properties": {
          "label": { "type": "string" },
          "value": { "type": "string" },
          "severity": { "type": "string", "enum": ["info", "watch", "high"] }
        },
        "additionalProperties": false
      }
    },
    "citations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["url", "retrieved_at"],
        "properties": {
          "source": { "type": "string" },
          "title": { "type": "string", "minLength": 3 },
          "url": { "type": "string", "pattern": "^https://" },
          "retrieved_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "ISO date the source was read." },
          "locator": { "type": "string", "description": "Table, page or section that holds the value." },
          "quote": { "type": "string", "description": "Verbatim supporting text from the source." }
        },
        "additionalProperties": false
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "enum": ["agent-extracted", "human-verified"] } }, "required": ["status"] },
      "then": { "required": ["citations"], "properties": { "citations": { "minItems": 1 } } }
    },
    {
      "if": { "properties": { "status": { "const": "disputed" } }, "required": ["status"] },
      "then": { "required": ["dispute_url"] }
    }
  ]
}
